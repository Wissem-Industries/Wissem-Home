# Public site URL used for canonical URLs, sitemap.xml and robots.txt
NUXT_PUBLIC_SITE_URL=https://example.com

# Host port exposed by docker-compose
APP_PORT=3000

# Telegram bot configuration for notifications.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Optional Plausible override. Leave empty to use the current hostname.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
NUXT_PUBLIC_PLAUSIBLE_API_HOST=
