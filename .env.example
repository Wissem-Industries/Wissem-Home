# Public site URL used for canonical URLs, sitemap.xml and robots.txt
SITE_URL=https://example.com

# Host port exposed by docker-compose
APP_PORT=3000

# SMTP configuration for the contact form
# Leave these empty if you don't want email sending in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional Plausible override. Leave empty to use the current hostname.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
