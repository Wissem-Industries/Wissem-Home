# Canonical public URL.
NUXT_PUBLIC_SITE_URL=https://www.wissem.pro

# Port exposed by Docker Compose.
APP_PORT=3000

# Telegram notification destination for the contact form.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Optional Plausible overrides. The current hostname is used when empty.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
NUXT_PUBLIC_PLAUSIBLE_API_HOST=
